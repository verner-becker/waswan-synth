{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WASWAN Music Lab Lesson v1",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "track",
    "mode",
    "handMode",
    "key",
    "meter",
    "tempoBpm",
    "ppq",
    "learningGoal",
    "notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "track": {
      "enum": [
        "melody",
        "harmony",
        "technique"
      ]
    },
    "mode": {
      "enum": [
        "strict",
        "guided",
        "creative"
      ]
    },
    "handMode": {
      "enum": [
        "RH",
        "LH",
        "BOTH",
        "FREE"
      ]
    },
    "key": {
      "type": "object",
      "required": [
        "tonic",
        "mode",
        "fifths"
      ],
      "additionalProperties": false,
      "properties": {
        "tonic": {
          "type": "string",
          "pattern": "^[A-G](#|b)?$"
        },
        "mode": {
          "enum": [
            "major",
            "minor",
            "modal"
          ]
        },
        "fifths": {
          "type": "integer",
          "minimum": -7,
          "maximum": 7
        }
      }
    },
    "meter": {
      "type": "object",
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false,
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "denominator": {
          "enum": [
            2,
            4,
            8
          ]
        }
      }
    },
    "tempoBpm": {
      "type": "number",
      "minimum": 30,
      "maximum": 240
    },
    "ppq": {
      "const": 480
    },
    "learningGoal": {
      "type": "string",
      "minLength": 8
    },
    "instructions": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "referenceOnly": {
      "type": "boolean"
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pitchRequired": {
          "type": "boolean"
        },
        "rhythmRequired": {
          "type": "boolean"
        },
        "allowInversions": {
          "type": "boolean"
        },
        "allowExtraNotes": {
          "type": "boolean"
        },
        "chordOnsetWindowMs": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000
        },
        "timingWindowMs": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/note"
      }
    }
  },
  "$defs": {
    "note": {
      "type": "object",
      "required": [
        "id",
        "pitch",
        "startTick",
        "durationTick",
        "hand"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9-]{1,40}$"
        },
        "pitch": {
          "type": "object",
          "required": [
            "step",
            "alter",
            "octave",
            "midi"
          ],
          "additionalProperties": false,
          "properties": {
            "step": {
              "enum": [
                "C",
                "D",
                "E",
                "F",
                "G",
                "A",
                "B"
              ]
            },
            "alter": {
              "type": "integer",
              "minimum": -2,
              "maximum": 2
            },
            "octave": {
              "type": "integer",
              "minimum": -1,
              "maximum": 9
            },
            "midi": {
              "type": "integer",
              "minimum": 0,
              "maximum": 127
            }
          }
        },
        "startTick": {
          "type": "integer",
          "minimum": 0
        },
        "durationTick": {
          "type": "integer",
          "minimum": 1
        },
        "hand": {
          "enum": [
            "RH",
            "LH"
          ]
        },
        "finger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "articulation": {
          "enum": [
            "legato",
            "staccato",
            "tenuto",
            "accent"
          ]
        }
      }
    }
  }
}
